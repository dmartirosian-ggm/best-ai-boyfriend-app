---
interface Props { pros: string[]; cons: string[] }
const { pros, cons } = Astro.props;
---

<div class="pc">
  <div>
    <p class="h good">What we like</p>
    <ul>{pros.map((p) => <li><span aria-hidden="true">+</span>{p}</li>)}</ul>
  </div>
  <div>
    <p class="h bad">Watch out for</p>
    <ul>{cons.map((c) => <li><span aria-hidden="true">–</span>{c}</li>)}</ul>
  </div>
</div>

<style>
  .pc { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 24px; }
  .h { font-weight: 700; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 6px; }
  .good { color: var(--good); }
  .bad { color: var(--bad); }
  ul { list-style: none; margin: 0; padding: 0; font-size: 0.93rem; }
  li { display: flex; gap: 8px; margin: 4px 0; color: var(--ink-2); }
  li span { font-weight: 700; width: 10px; flex: none; }
  div > div:first-child li span { color: var(--good); }
  div > div:last-child li span { color: var(--bad); }
  @media (max-width: 640px) { .pc { grid-template-columns: 1fr; } }
</style>
