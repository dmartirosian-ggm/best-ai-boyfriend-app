---
/** Scorecard box at the top of a review. <ReviewSummary app="candy-ai" /> */
import { getApp, PLATFORM_LABEL, NSFW_LABEL } from '~/lib/apps';
import AppMark from './AppMark.astro';
import Score from './Score.astro';
import ProsCons from './ProsCons.astro';
import CTA from './CTA.astro';
interface Props { app: string; verdict?: string }
const { app: slug, verdict } = Astro.props;
const app = getApp(slug);
const yn = (v: boolean | null) => (v === null ? 'Unclear' : v ? 'Yes' : 'No');
const rows: [string, string][] = [
  ['Price', app.startingPrice],
  ['Free plan', app.freeShort],
  ['Platforms', app.platforms.map((p) => PLATFORM_LABEL[p]).join(', ')],
  ['Boyfriend mode', app.boyfriendMode],
  ['Voice calls', yn(app.features.voiceCalls)],
  ['Image generation', yn(app.features.imageGen)],
  ['Custom characters', yn(app.features.customCharacters)],
  ['Adult content', NSFW_LABEL[app.nsfw]],
  ['Minimum age', app.ageLabel ?? (app.minAge ? `${app.minAge}+` : 'Not stated')],
];
---

<section class="rs" aria-label={`${app.name} at a glance`}>
  <div class="top">
    <AppMark app={app} size={64} />
    <div class="n">
      <p class="eyebrow">Our verdict</p>
      <p class="name">{app.name}</p>
      <p class="muted bf">Best for: {app.bestFor}</p>
    </div>
    <Score score={app.score} size="lg" />
  </div>
  {verdict && <p class="v">{verdict}</p>}
  <dl>
    {rows.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
  </dl>
  <ProsCons pros={app.pros} cons={app.cons} />
  <div class="cta">
    <CTA app={app.slug} label={app.hasAffiliate ? `Try ${app.name}` : `Visit ${app.name}`} />
    <span class="muted small">Facts checked {new Date(app.verified).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
  </div>
</section>

<style>
  .rs { margin: 1.5em 0 2em; padding: 24px; border-radius: calc(var(--radius) + 4px); background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow); }
  .top { display: flex; align-items: center; gap: 16px; }
  .n { flex: 1; }
  .n p { margin: 0; }
  .name { font-family: var(--font-display); font-size: 1.6rem; font-weight: 600; line-height: 1.1; }
  .bf { font-size: 0.92rem; }
  .v { margin: 16px 0 0; padding: 12px 16px; background: var(--accent-soft); border-radius: 10px; color: var(--ink); }
  dl { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; margin: 18px 0; }
  dl div { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 0.92rem; }
  dt { color: var(--muted); }
  dd { margin: 0; text-align: right; color: var(--ink); font-weight: 500; }
  .cta { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 20px; }
  .small { font-size: 0.82rem; }
  @media (max-width: 640px) { dl { grid-template-columns: 1fr; } .rs { padding: 20px 16px; } }
</style>
