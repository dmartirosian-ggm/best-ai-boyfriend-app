---
import { render } from 'astro:content';
import Base from './Base.astro';
import FAQ from '~/components/FAQ.astro';
import { mdxComponents } from '~/components';
import { SITE } from '~/config';
import { getApp } from '~/lib/apps';
import { articleHref, getArticles, TYPE_HUB, TYPE_LABEL, type Article } from '~/lib/articles';

interface Props { entry: Article }
const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);

const site = Astro.site!;
const url = new URL(articleHref(entry), site).href;
const isHome = d.type === 'home';
const isPage = d.type === 'page';
const hub = TYPE_HUB[d.type];
const h1 = d.h1 ?? d.title;
const toc = headings.filter((h) => h.depth === 2);
const fmt = (date: Date) => date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

// Related: explicit list first, then siblings of the same type, then pages about the same apps.
const all = await getArticles();
const byHref = new Map(all.map((a) => [articleHref(a), a]));
const related: Article[] = [];
const add = (a?: Article) => {
  if (a && a.id !== entry.id && a.data.type !== 'page' && !related.includes(a)) related.push(a);
};
d.related.forEach((h) => add(byHref.get(h)));
all.filter((a) => d.apps.length && a.data.apps.some((s) => d.apps.includes(s))).forEach(add);
all.filter((a) => a.data.type === d.type).forEach(add);
const relatedLinks = related.slice(0, 6);

// Structured data
const crumbs = [{ name: 'Home', href: '/' }];
if (hub) crumbs.push({ name: hub.label, href: hub.href });
if (!isHome) crumbs.push({ name: h1, href: articleHref(entry) });

const schema: Record<string, unknown>[] = [];
const author = { '@type': 'Organization', name: SITE.author.name, url: new URL(SITE.author.url, site).href };
if (d.type === 'review' && d.apps[0]) {
  const app = getApp(d.apps[0]);
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'Review',
    name: d.title,
    url,
    datePublished: d.published.toISOString(),
    dateModified: d.updated.toISOString(),
    author,
    publisher: { '@type': 'Organization', name: SITE.name },
    itemReviewed: {
      '@type': 'SoftwareApplication',
      name: app.name,
      applicationCategory: 'LifestyleApplication',
      operatingSystem: app.platforms.map((p) => ({ web: 'Web', ios: 'iOS', android: 'Android' })[p]).join(', '),
      url: app.website,
    },
    reviewRating: { '@type': 'Rating', ratingValue: app.score, bestRating: 10, worstRating: 0 },
    reviewBody: d.description,
  });
} else if (!isPage) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: h1,
    description: d.description,
    url,
    datePublished: d.published.toISOString(),
    dateModified: d.updated.toISOString(),
    author,
    publisher: { '@type': 'Organization', name: SITE.name },
  });
}
if (d.faqs.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
if (crumbs.length > 1) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, site).href })),
  });
}
---

<Base title={d.title} description={d.description} ogType={isHome ? 'website' : 'article'} schema={schema}>
  <div class:list={['hero', isHome && 'hero--home']}>
    <div class="wrap">
      {
        crumbs.length > 1 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            {crumbs.map((c, i) => (i < crumbs.length - 1 ? <><a href={c.href}>{c.name}</a><span aria-hidden="true">/</span></> : <span aria-current="page">{c.name}</span>))}
          </nav>
        )
      }
      {!isPage && <p class="eyebrow">{TYPE_LABEL[d.type]} · Updated {d.updated.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}</p>}
      <h1>{h1}</h1>
      {
        !isPage && (
          <p class="byline">
            By <a href={SITE.author.url}>{SITE.author.name}</a> · Last updated <time datetime={d.updated.toISOString()}>{fmt(d.updated)}</time> ·{' '}
            <a href="/how-we-test/">How we test</a>
          </p>
        )
      }
      {d.tldr && <div class="tldr"><strong>Short answer:</strong> {d.tldr}</div>}
    </div>
  </div>

  <div class:list={['wrap', 'layout', (isPage || toc.length < 3) && 'layout--single']}>
    <article class="prose">
      {!isPage && <p class="disclosure">{SITE.disclosure} <a href="/affiliate-disclosure/">Learn more</a>.</p>}
      <Content components={mdxComponents} />
      <FAQ faqs={d.faqs} />
      {
        relatedLinks.length > 0 && (
          <section class="related">
            <h2>Keep reading</h2>
            <ul>
              {relatedLinks.map((r) => (
                <li>
                  <a href={articleHref(r)}>
                    <span class="eyebrow">{TYPE_LABEL[r.data.type]}</span>
                    <span class="rt">{r.data.h1 ?? r.data.title}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        !isPage && (
          <aside class="author">
            <p>
              <strong>About this guide.</strong> Written by the {SITE.author.name}. We create accounts, use the free tier, pay for at least one month
              where a paid plan exists, and re-check pricing and policies regularly. Rankings are editorial and never sold.{' '}
              <a href="/how-we-test/">Read our methodology</a>.
            </p>
          </aside>
        )
      }
    </article>
    {
      !isPage && toc.length >= 3 && (
        <aside class="toc" aria-label="On this page">
          <p class="eyebrow">On this page</p>
          <ol>
            {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            {d.faqs.length > 0 && <li><a href="#faq">FAQ</a></li>}
          </ol>
        </aside>
      )
    }
  </div>
</Base>

<style>
  .hero { padding: 28px 0 8px; }
  .hero--home { padding: 56px 0 24px; background: radial-gradient(1200px 300px at 20% -10%, var(--accent-soft), transparent 70%); }
  .hero--home h1 { font-size: clamp(2.3rem, 5.5vw, 3.8rem); max-width: 18ch; }
  .hero h1 { max-width: 26ch; }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; font-size: 0.85rem; color: var(--muted); margin-bottom: 14px; }
  .crumbs a { color: var(--muted); }
  .eyebrow { margin: 0; }
  .byline { color: var(--muted); font-size: 0.9rem; margin: 0 0 16px; }
  .byline a { color: var(--ink-2); }
  .tldr { max-width: var(--prose); padding: 14px 18px; border-radius: var(--radius); background: var(--card); border: 1px solid var(--line); border-left: 4px solid var(--accent); color: var(--ink-2); margin-bottom: 8px; }
  .tldr strong { color: var(--ink); }

  .layout { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 56px; align-items: start; padding-top: 16px; }
  .layout--single { grid-template-columns: minmax(0, 1fr); }
  .layout article { max-width: 780px; }
  .disclosure { font-size: 0.82rem; color: var(--muted); padding: 8px 12px; border: 1px dashed var(--line); border-radius: 10px; }
  .toc { position: sticky; top: 88px; font-size: 0.9rem; }
  .toc ol { list-style: none; padding: 0; margin: 10px 0 0; border-left: 2px solid var(--line); }
  .toc li { margin: 0; }
  .toc a { display: block; padding: 5px 0 5px 14px; color: var(--ink-2); text-decoration: none; line-height: 1.35; }
  .toc a:hover { color: var(--accent); }

  .related ul { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .related li { margin: 0; }
  .related a { display: block; height: 100%; padding: 14px 16px; border-radius: var(--radius); border: 1px solid var(--line); background: var(--card); text-decoration: none; }
  .related a:hover { border-color: var(--accent); }
  .related .eyebrow { display: block; font-size: 0.7rem; }
  .rt { color: var(--ink); font-weight: 600; line-height: 1.3; display: block; margin-top: 4px; }
  .author { margin-top: 40px; padding: 18px 20px; border-radius: var(--radius); background: var(--paper-2); font-size: 0.92rem; }
  .author p { margin: 0; }

  @media (max-width: 960px) {
    .layout { grid-template-columns: minmax(0, 1fr); }
    .toc { display: none; }
  }
  @media (max-width: 640px) { .related ul { grid-template-columns: 1fr; } }
</style>
