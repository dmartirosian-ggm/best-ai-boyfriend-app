---
/**
 * Affiliate redirect: /go/{slug}/ -> app.affiliateUrl (falls back to the app's website).
 * The page a click came from arrives as ?src= and is forwarded to the network as sub1
 * (Everflow-style sub IDs), so conversions can be attributed per page.
 * Static meta-refresh so it works on any host.
 */
import { APPS } from '~/data/apps';
export function getStaticPaths() {
  return APPS.filter((a) => a.hasAffiliate).map((app) => ({ params: { slug: app.slug }, props: { app } }));
}
const { app } = Astro.props;
const target = app.affiliateUrl ?? app.website;
const tagSub1 = app.affiliateUrl !== null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`1;url=${target}`} />
    <title>Redirecting to {app.name}…</title>
    <script is:inline define:vars={{ target, tagSub1 }}>
      var url = new URL(target);
      var src = new URLSearchParams(location.search).get('src');
      if (tagSub1 && src && !url.searchParams.has('sub1')) url.searchParams.set('sub1', src.slice(0, 100));
      location.replace(url.href);
    </script>
  </head>
  <body>
    <p>Taking you to <a href={target} rel="sponsored nofollow">{app.name}</a>…</p>
  </body>
</html>
