---
/**
 * Affiliate redirect: /go/{slug}/ -> app.affiliateUrl (falls back to the app's website).
 * The page a click came from arrives as ?src= and is forwarded to the network as sub3
 * (Everflow sub IDs), so conversions can be attributed per page. sub1/sub2 are left alone:
 * OurDream's Create landers read sub1 as companion gender and sub2 as traffic type, so set
 * those in the affiliateUrl itself (e.g. ...&sub1=male&sub2=nsfw).
 * Static meta-refresh so it works on any host.
 */
import { APPS } from '~/data/apps';
export function getStaticPaths() {
  const affiliates = APPS.filter((a) => a.hasAffiliate);
  return [
    ...affiliates.map((app) => ({ params: { slug: app.slug }, props: { app, url: app.affiliateUrl } })),
    // /go/{slug}-nsfw/ -> adult lander, for apps that have one (see NSFW_PAGES in src/lib/apps.ts).
    ...affiliates
      .filter((a) => a.affiliateUrlNsfw)
      .map((app) => ({ params: { slug: `${app.slug}-nsfw` }, props: { app, url: app.affiliateUrlNsfw ?? null } })),
  ];
}
const { app, url } = Astro.props;
const target = url ?? app.website;
const SOURCE_PARAM = app.sourceParam === undefined ? 'sub3' : app.sourceParam;
const tagSource = url !== null && SOURCE_PARAM !== null;
const forced = url !== null ? (app.affiliateParams ?? {}) : {};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <meta http-equiv="refresh" content={`1;url=${target}`} />
    <title>Redirecting to {app.name}…</title>
    <script is:inline define:vars={{ target, tagSource, SOURCE_PARAM, forced }}>
      var url = new URL(target);
      var src = new URLSearchParams(location.search).get('src');
      if (tagSource && src && !url.searchParams.has(SOURCE_PARAM)) url.searchParams.set(SOURCE_PARAM, src.slice(0, 100));
      for (var k in forced) url.searchParams.set(k, forced[k]);
      location.replace(url.href);
    </script>
  </head>
  <body>
    <p>Taking you to <a href={target} rel="sponsored nofollow">{app.name}</a>…</p>
  </body>
</html>
