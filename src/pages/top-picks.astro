---
/**
 * Paid-traffic landing page (Google Ads). Not in the sitemap and noindex.
 * No site header or navigation: the logo is plain text, and the only links out are the app CTAs
 * plus the disclosure and privacy links in the footer.
 */
import Base from '~/layouts/Base.astro';
import { getApps, ctaHref, ctaRel } from '~/lib/apps';
import { SITE } from '~/config';

const PAGE = '/top-picks/';
const UPDATED = 'November 2026';

/** Per-card copy for this page; facts come from src/data/apps.ts. */
const COPY: Record<string, { badge?: string; highlights: string[]; downside: string; cta: string }> = {
  'nomi-ai': {
    badge: 'Our top pick',
    highlights: ['Remembers your history weeks later', 'Voice calls and selfies from him', 'Annual plan works out to about $8/mo'],
    downside: 'The free plan runs out fast.',
    cta: 'Visit Nomi',
  },
  'ourdream-ai': {
    badge: 'Best for photos and video',
    highlights: ['About 50 free messages a day', 'Unlimited chat on Premium', 'Generates pictures and short videos of him'],
    downside: 'Photos and video use coins, even on Premium.',
    cta: 'Visit OurDream',
  },
  beau: {
    badge: 'Our own app',
    highlights: ['Built only for an AI boyfriend', 'Photos from his day, same face every time', 'Always safe for work, no ads'],
    downside: 'No voice yet, and it runs in the browser only.',
    cta: 'Try Beau free',
  },
};

const apps = getApps(['nomi-ai', 'ourdream-ai', 'beau']).map((app) => ({
  app,
  copy: COPY[app.slug],
  href: ctaHref(app, PAGE),
  rel: ctaRel(app),
}));
const stars = (score: number) => Math.round((score / 10) * 5 * 2) / 2;
---

<Base
  title="Best AI Boyfriend Apps, Ranked"
  description="We tested the most popular AI boyfriend apps for memory, photos, price and free plans. Here are the ones worth trying."
  noindex
  bare
>
  <header slot="bare-header" class="lp-top">
    <div class="wrap lp-bar">
      <span class="lp-logo" aria-label={SITE.name}>
        <svg width="24" height="24" viewBox="0 0 32 32" aria-hidden="true">
          <path d="M16 28s-11-6.6-11-14.2C5 9.5 8.2 6 12.2 6c1.6 0 3 .7 3.8 1.9C16.8 6.7 18.2 6 19.8 6 23.8 6 27 9.5 27 13.8 27 21.4 16 28 16 28z" fill="var(--accent)"></path>
          <circle cx="12.5" cy="14" r="1.6" fill="var(--paper)"></circle>
          <circle cx="19.5" cy="14" r="1.6" fill="var(--paper)"></circle>
        </svg>
        <span>Best<b>AI</b>Boyfriend</span>
      </span>
      <span class="lp-ad">Advertising disclosure ↓</span>
    </div>
  </header>

  <section class="wrap lp-hero">
    <p class="lp-kicker">Updated {UPDATED}</p>
    <h1>The best AI boyfriend apps, ranked</h1>
    <p class="lp-lede">We compared the most popular AI boyfriend apps on memory, photos, price and how much you get for free. These three came out on top.</p>
    <ul class="lp-checks" aria-label="How we ranked them">
      <li>Remembers what you tell him</li>
      <li>Free plan you can actually use</li>
      <li>Photos and voice</li>
      <li>Fair pricing</li>
    </ul>
  </section>

  <section class="wrap lp-list" aria-label="Ranked apps">
    {
      apps.map(({ app, copy, href, rel }, i) => (
        <article class={`lp-card${i === 0 ? ' first' : ''}`}>
          {copy.badge && <p class={`lp-badge${app.ownedByUs ? ' own' : ''}`}>{copy.badge}</p>}
          <div class="lp-rank" aria-label={`Rank ${i + 1}`}>{i + 1}</div>
          <div class="lp-id">
            {app.logo ? (
              <img class="lp-mark" src={app.logo} alt="" width="56" height="56" />
            ) : (
              <span class="lp-mark mono" aria-hidden="true">{app.name.slice(0, 1)}</span>
            )}
            <div>
              <h2>{app.name}</h2>
              <p class="lp-best">Best for: {app.bestFor}</p>
            </div>
          </div>
          <ul class="lp-high">
            {copy.highlights.map((h) => <li>{h}</li>)}
            <li class="con">{copy.downside}</li>
          </ul>
          <div class="lp-score">
            <p class="num">{app.score.toFixed(1)}</p>
            <p class="stars" aria-label={`${stars(app.score)} out of 5 stars`}>
              {[1, 2, 3, 4, 5].map((n) => (
                <span class={n <= stars(app.score) ? 'on' : n - 0.5 === stars(app.score) ? 'half' : ''}>★</span>
              ))}
            </p>
            <p class="price">Free plan · {app.startingPrice}</p>
          </div>
          <a class="lp-cta" href={href} rel={rel} target="_blank" data-app={app.slug}>
            {copy.cta} <span aria-hidden="true">→</span>
          </a>
        </article>
      ))
    }
  </section>

  <section class="wrap lp-how">
    <h2>How we pick</h2>
    <p>
      We score each app out of 10 on the same things: how well he remembers what you tell him, what the free plan really includes, photo and
      voice features, and what it costs to keep going. Facts come from each app's own pricing and features plus independent reviews, and we
      re-check them regularly.
    </p>
  </section>

  <footer slot="bare-footer" class="lp-foot" id="disclosure">
    <div class="wrap">
      <p>
        <strong>Advertising disclosure:</strong> this page is paid advertising. We earn a commission when you sign up through some links here, at
        no cost to you, and that can affect which apps we show. Beau is made by the team behind this site. All apps are for adults 18+.
      </p>
      <p class="links">
        <a href="/affiliate-disclosure/" rel="nofollow">Full disclosure</a>
        <a href="/privacy/" rel="nofollow">Privacy</a>
        <span>© {new Date().getFullYear()} {SITE.name}</span>
      </p>
    </div>
  </footer>
</Base>

<script is:inline>
  // Split-test label for this lander (sent to the network as sub5). Change per variant.
  try { localStorage.setItem('bab_split', 'tp1'); } catch (e) {}
</script>

<style>
  .lp-top { border-bottom: 1px solid var(--line); background: var(--paper); }
  .lp-bar { display: flex; align-items: center; justify-content: space-between; height: 56px; }
  .lp-logo { display: flex; align-items: center; gap: 7px; font-family: var(--font-display); font-weight: 600; font-size: 1.12rem; color: var(--ink); cursor: default; }
  .lp-logo b { color: var(--accent); }
  .lp-ad { font-size: 0.78rem; color: var(--muted); }

  .lp-hero { padding-top: 34px; padding-bottom: 18px; max-width: 852px; margin-left: auto; margin-right: auto; }
  .lp-kicker { margin: 0 0 6px; font-size: 0.82rem; font-weight: 700; color: var(--good); text-transform: uppercase; letter-spacing: 0.06em; }
  .lp-hero h1 { margin: 0 0 12px; font-size: clamp(1.9rem, 5vw, 2.9rem); line-height: 1.08; }
  .lp-lede { margin: 0 0 18px; color: var(--ink-2); font-size: 1.05rem; }
  .lp-checks { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
  .lp-checks li { padding: 5px 12px 5px 28px; border-radius: 999px; background: var(--card); border: 1px solid var(--line); font-size: 0.88rem; position: relative; }
  .lp-checks li::before { content: '✓'; position: absolute; left: 11px; color: var(--good); font-weight: 700; }

  .lp-list { display: grid; gap: 18px; padding-top: 10px; padding-bottom: 30px; }
  .lp-card {
    position: relative; display: grid; align-items: center; gap: 18px 24px;
    grid-template-columns: 44px minmax(200px, 1.1fr) 1.4fr 130px 170px;
    padding: 24px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow);
  }
  .lp-card.first { border: 2px solid var(--accent); }
  .lp-badge { position: absolute; top: -12px; left: 22px; margin: 0; padding: 3px 12px; border-radius: 999px; background: var(--accent); color: #fff; font-size: 0.78rem; font-weight: 700; }
  .lp-badge.own { background: var(--ink-2); }
  .lp-rank { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--paper-2); font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; }
  .first .lp-rank { background: var(--accent); color: #fff; }
  .lp-id { display: flex; align-items: center; gap: 14px; }
  .lp-mark { width: 56px; height: 56px; border-radius: 14px; flex: none; object-fit: cover; }
  .lp-mark.mono { display: grid; place-items: center; background: var(--accent-soft); color: var(--accent); font-family: var(--font-display); font-weight: 700; font-size: 1.6rem; }
  .lp-id h2 { margin: 0; font-size: 1.4rem; }
  .lp-best { margin: 2px 0 0; font-size: 0.88rem; color: var(--muted); }
  .lp-high { margin: 0; padding: 0; list-style: none; display: grid; gap: 5px; font-size: 0.94rem; }
  .lp-high li { padding-left: 22px; position: relative; }
  .lp-high li::before { content: '✓'; position: absolute; left: 0; color: var(--good); font-weight: 700; }
  .lp-high li.con { color: var(--muted); }
  .lp-high li.con::before { content: '–'; color: var(--bad); }
  .lp-score { text-align: center; }
  .lp-score p { margin: 0; }
  .num { font-family: var(--font-display); font-weight: 700; font-size: 2.2rem; line-height: 1; }
  .stars { color: #d9d0c9; letter-spacing: 1px; }
  .stars .on { color: var(--gold); }
  .stars .half { background: linear-gradient(90deg, var(--gold) 50%, #d9d0c9 50%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .price { font-size: 0.78rem; color: var(--muted); }
  .lp-cta {
    display: flex; justify-content: center; align-items: center; gap: 8px; padding: 14px 16px; border-radius: 12px;
    background: var(--accent); color: #fff; font-weight: 700; text-decoration: none; text-align: center;
  }
  .lp-cta:hover { filter: brightness(0.92); }

  .lp-how { max-width: 852px; padding-top: 6px; padding-bottom: 36px; }
  .lp-how h2 { font-size: 1.3rem; margin: 0 0 8px; }
  .lp-how p { margin: 0; color: var(--ink-2); }

  .lp-foot { border-top: 1px solid var(--line); background: var(--paper-2); padding-top: 22px; padding-bottom: 30px; font-size: 0.84rem; color: var(--ink-2); }
  .lp-foot p { margin: 0 0 10px; max-width: 820px; }
  .lp-foot .links { display: flex; gap: 16px; flex-wrap: wrap; color: var(--muted); }
  .lp-foot a { color: var(--ink-2); }

  @media (max-width: 900px) {
    .lp-card { grid-template-columns: 34px 1fr auto; padding: 26px 16px 18px; gap: 14px 12px; }
    .lp-rank { width: 34px; height: 34px; font-size: 1.05rem; }
    .lp-mark { display: none !important; }
    .lp-id { grid-column: 2 / 3; }
    .lp-id h2 { font-size: 1.25rem; }
    .lp-score { max-width: 112px; }
    .lp-best { font-size: 0.82rem; }
    .lp-score { grid-column: 3; grid-row: 1; }
    .lp-high { grid-column: 1 / -1; }
    .lp-cta { grid-column: 1 / -1; }
    .num { font-size: 1.8rem; }
  }
</style>
